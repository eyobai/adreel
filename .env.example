# AdReel configuration. Copy to .env. Rendering needs nothing; the AI layer needs keys.
# Phase 3–4 will add Telegram, database and Chapa settings here.

# --- AI providers ---
# Pick providers. "fake"/"heuristic" need no keys (tests, demos, outages).
ADREEL_TRANSCRIBER=elevenlabs          # elevenlabs | fake
ADREEL_PLANNER=gemini                  # gemini | heuristic
ADREEL_TTS_STANDARD=azure              # azure | fake
ADREEL_TTS_PREMIUM=elevenlabs          # elevenlabs | azure | fake
ADREEL_LANGUAGE=am

# ElevenLabs: Scribe speech-to-text + premium TTS
ADREEL_ELEVENLABS_API_KEY=
ADREEL_ELEVENLABS_STT_MODEL=scribe_v1
ADREEL_ELEVENLABS_TTS_MODEL=eleven_v3
ADREEL_ELEVENLABS_VOICE_ID=            # required for premium voiceover
ADREEL_ELEVENLABS_TTS_LANGUAGE=am

# Gemini (planner)
ADREEL_GEMINI_API_KEY=
ADREEL_GEMINI_MODEL=gemini-flash-latest
ADREEL_GEMINI_MEDIA_RESOLUTION=low     # low | medium | high (low = far fewer video tokens)
# ADREEL_GEMINI_THINKING_BUDGET=0      # unset = model default; 0 disables thinking (cheaper)
ADREEL_GEMINI_TEMPERATURE=0.4
ADREEL_GEMINI_INLINE_MAX_MB=15         # larger proxy batches go through the Files API
ADREEL_PLAN_ATTEMPTS=3                 # validate/retry rounds before the heuristic fallback

# Azure Speech (standard voiceover)
ADREEL_AZURE_SPEECH_KEY=
ADREEL_AZURE_SPEECH_REGION=eastus
ADREEL_AZURE_VOICE=am-ET-MekdesNeural  # or am-ET-AmehaNeural

ADREEL_HTTP_TIMEOUT_S=120

# --- unit prices for the cost log (USD). Check against your plans. ---
# ADREEL_PRICES__STT_ELEVENLABS_PER_HOUR=0.40
# ADREEL_PRICES__LLM_GEMINI_INPUT_PER_MTOK=0.30
# ADREEL_PRICES__LLM_GEMINI_AUDIO_INPUT_PER_MTOK=1.00
# ADREEL_PRICES__LLM_GEMINI_OUTPUT_PER_MTOK=2.50
# ADREEL_PRICES__TTS_AZURE_PER_MCHAR=16
# ADREEL_PRICES__TTS_ELEVENLABS_PER_KCHAR=0.18
# ADREEL_PRICES__USD_TO_ETB=155

# --- binaries / limits ---
ADREEL_FFMPEG_BIN=ffmpeg
ADREEL_FFPROBE_BIN=ffprobe
# 0 = let ffmpeg pick. Set to the worker's CPU quota when running several workers per host.
ADREEL_FFMPEG_THREADS=0
# Hard timeout (seconds) for any single ffmpeg call
ADREEL_FFMPEG_TIMEOUT_S=900

# --- paths ---
# Cache of normalised clips and rendered segments (safe to delete; rebuilt on demand)
ADREEL_WORK_DIR=.work
# Extra template directories (JSON list). Templates there override built-ins by id.
# ADREEL_TEMPLATES_DIRS=["/srv/adreel/templates"]
# Override bundled assets only if you know why:
# ADREEL_FONTS_DIR=/path/to/fonts
# ADREEL_FACE_MODEL_PATH=/path/to/blaze_face_full_range.tflite

# --- rendering ---
# Face-aware 9:16 reframing (needs the [face] extra: mediapipe + numpy, and libEGL)
ADREEL_FACE_TRACKING=true
ADREEL_WATERMARK_TEXT=Made with AdReel

# --- logging ---
ADREEL_LOG_LEVEL=INFO
# JSON log lines (for prod log shipping) instead of the coloured console renderer
ADREEL_LOG_JSON=false
